# ==========================================
# GEO Studio 多模型引擎配置说明 (AI Providers)
# ==========================================

# 1. Google Gemini 官方接口 (AI Studio 自动注入或本地配置)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. 通用 OpenAI / DeepSeek / 本地 Ollama 接口 (兼容 OpenAI 格式)
# - 官方 DeepSeek: OPENAI_BASE_URL="https://api.deepseek.com"
# - 本地离线 Ollama: OPENAI_BASE_URL="http://localhost:11434/v1" (API_KEY 可留空)
# - 硅基流动: OPENAI_BASE_URL="https://api.siliconflow.cn/v1"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL_NAME="deepseek-chat"

# 3. Perplexity AI 原生带搜索接口
PERPLEXITY_API_KEY=""

# 4. 激活引擎选择: "auto" (自动检测) | "gemini" | "deepseek" | "ollama" | "openai" | "builtin"
AI_PROVIDER="auto"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
